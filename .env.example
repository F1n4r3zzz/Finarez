# Local development values (see README). Hosted environments set these as secrets instead.
DATABASE_URL=postgres://finanz:finanz_local@localhost:5432/finanz_dev
TEST_DATABASE_URL=postgres://finanz:finanz_local@localhost:5432/finanz_test
PORT=3000
# Public origin of the web app (Vite dev server proxies /api to the API).
APP_URL=http://localhost:5173
# Local only. Generate your own: openssl rand -base64 32
AUTH_SECRET=local-dev-only-replace-me-with-openssl-output
# Emails go to the terminal locally; this caps them per day like the provider's free tier.
EMAIL_DAILY_LIMIT=90
# Sign-in attempts per address every 15 minutes (default 5; production never allows more).
# AUTH_SIGN_IN_LIMIT=5
# Sign-ups per address every hour (default 5; production never allows more).
# AUTH_SIGN_UP_LIMIT=5
# Hosted environments send through Resend instead (set as secrets there, never here):
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# EMAIL_FROM=Finarez <onboarding@resend.dev>
