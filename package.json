{
  "name": "finanz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @finanz/api dev",
    "db:migrate": "pnpm --filter @finanz/api db:migrate",
    "check": "pnpm lint && pnpm typecheck && pnpm deps && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "deps": "depcruise apps packages",
    "test": "vitest run",
    "e2e": "pnpm --filter @finanz/e2e e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.0.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
